# Copy to .env.local and fill in from your Supabase project (Settings → API).
# .env.local is gitignored — never commit real keys.

# Used by the app (Vite exposes VITE_-prefixed vars to the client bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used only by scripts/seed-supabase.mjs, run manually from your machine.
# Never prefix this with VITE_ — that would bundle it into the client build.
SUPABASE_SERVICE_ROLE_KEY=
